{
  "compilerOptions": {
    "target": "es6",
    "module": "esnext",
    "lib": [
      "es2020"
    ],
    "allowJs": true,
    "outDir": "ts_out",
    // "noEmit": false,

    "strict": true,
    "alwaysStrict": true,
    "noImplicitReturns": true,

    "esModuleInterop": true,
    "moduleResolution": "node",
    "skipLibCheck": false,

    // cel-js ships a broken .d.ts; use a local shim for type-checking only
    // (bundlers/runtime still resolve the real package)
    "baseUrl": ".",
    "paths": {
      "cel-js": ["./modules/celjs.d.ts"]
    }
  },
  "include": [
    "modules/**/*"
  ]
}
